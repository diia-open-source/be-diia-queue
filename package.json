{
    "name": "@diia-inhouse/diia-queue",
    "version": "14.0.16",
    "type": "module",
    "description": "Package provide queue functionality",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "repository": "https://github.com/diia-open-source/be-diia-queue",
    "author": "Diia",
    "license": "SEE LICENSE IN LICENSE.md",
    "engines": {
        "node": ">=24"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "rimraf dist/ && tsdown",
        "build-watch": "tsdown --watch",
        "lint": "oxlint && oxfmt --check .",
        "lint-fix": "oxlint --fix && oxfmt .",
        "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts registry.npmjs.org --validate-https",
        "format": "oxfmt \"src/**/*.ts\"",
        "prepare": "npm run build",
        "semantic-release": "semantic-release",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "find-circulars": "madge --circular --extensions ts ./"
    },
    "dependencies": {
        "@types/amqplib": "0.10.8",
        "amqplib": "0.10.9",
        "lodash": "4.18.1",
        "p-timeout": "4.1.0"
    },
    "peerDependencies": {
        "@diia-inhouse/diia-logger": ">=4.0.0",
        "@diia-inhouse/diia-metrics": ">=7.0.0",
        "@diia-inhouse/env": ">=3.0.0",
        "@diia-inhouse/errors": ">=2.0.0",
        "@diia-inhouse/types": ">=13.1.0",
        "@diia-inhouse/utils": ">=6.0.0",
        "@diia-inhouse/validators": ">=2.0.0",
        "@opentelemetry/api": ">=1.7.0"
    },
    "devDependencies": {
        "@diia-inhouse/configs": "7.0.0",
        "@diia-inhouse/diia-logger": "4.3.7",
        "@diia-inhouse/diia-metrics": "7.1.16",
        "@diia-inhouse/env": "3.3.7",
        "@diia-inhouse/errors": "2.1.7",
        "@diia-inhouse/oxc-config": "1.10.1",
        "@diia-inhouse/test": "8.2.6",
        "@diia-inhouse/types": "13.2.1",
        "@diia-inhouse/utils": "6.0.17",
        "@diia-inhouse/validators": "2.2.12",
        "@opentelemetry/api": "1.9.0",
        "@types/lodash": "4.17.24",
        "@types/node": "25.6.2",
        "@vitest/coverage-v8": "4.1.5",
        "@vitest/ui": "4.1.5",
        "lockfile-lint": "5.0.0",
        "madge": "8.0.0",
        "oxfmt": "0.48.0",
        "oxlint": "1.63.0",
        "oxlint-tsgolint": "0.22.1",
        "rimraf": "6.1.3",
        "tsdown": "0.22.0",
        "type-fest": "5.6.0",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "4.1.5",
        "vitest-mock-extended": "4.0.0"
    },
    "release": {
        "extends": "@diia-inhouse/configs/dist/semantic-release/package"
    },
    "commitlint": {
        "extends": "@diia-inhouse/configs/dist/commitlint"
    },
    "madge": {
        "tsConfig": "./tsconfig.json"
    }
}

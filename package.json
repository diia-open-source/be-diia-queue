{
    "name": "@diia-inhouse/diia-queue",
    "version": "14.4.8",
    "description": "Package provide queue functionality",
    "license": "SEE LICENSE IN LICENSE.md",
    "author": "diia-team",
    "repository": "https://github.com/diia-open-source/be-diia-queue",
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsdown",
        "build:watch": "tsdown --watch",
        "lint": "oxlint && oxfmt --check .",
        "lint-fix": "oxlint --fix && oxfmt .",
        "lint:lockfile": "lockfile-lint --path package-lock.json --allowed-hosts registry.npmjs.org --validate-https",
        "format": "oxfmt \"src/**/*.ts\"",
        "prepare": "npm run build",
        "semantic-release": "semantic-release",
        "test": "tsc -project tests/tsconfig.json -noEmit && vitest run",
        "test:watch": "vitest watch"
    },
    "dependencies": {
        "@types/amqplib": "0.10.8",
        "amqplib": "0.10.9",
        "lodash": "4.18.1"
    },
    "devDependencies": {
        "@diia-inhouse/configs": "7.6.0",
        "@diia-inhouse/diia-logger": "4.7.70",
        "@diia-inhouse/diia-metrics": "7.1.200",
        "@diia-inhouse/env": "3.3.122",
        "@diia-inhouse/errors": "2.3.52",
        "@diia-inhouse/oxc-config": "6.2.2",
        "@diia-inhouse/test": "8.4.18",
        "@diia-inhouse/types": "14.13.3",
        "@diia-inhouse/utils": "6.4.3",
        "@diia-inhouse/validators": "2.3.3",
        "@opentelemetry/api": "1.9.0",
        "@types/lodash": "4.17.24",
        "@types/node": "25.6.2",
        "@vitest/coverage-v8": "4.1.11",
        "@vitest/ui": "4.1.11",
        "lockfile-lint": "5.0.0",
        "oxfmt": "0.72.0",
        "oxlint": "1.87.0",
        "oxlint-tsgolint": "7.0.2003",
        "tsdown": "0.22.0",
        "type-fest": "5.6.0",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "4.1.11",
        "vitest-mock-extended": "4.0.0"
    },
    "peerDependencies": {
        "@diia-inhouse/diia-logger": ">=4.0.0",
        "@diia-inhouse/diia-metrics": ">=7.0.0",
        "@diia-inhouse/env": ">=3.0.0",
        "@diia-inhouse/errors": ">=2.0.0",
        "@diia-inhouse/types": ">=13.1.0",
        "@diia-inhouse/utils": ">=6.0.0",
        "@diia-inhouse/validators": ">=2.0.0",
        "@opentelemetry/api": ">=1.7.0"
    },
    "commitlint": {
        "extends": "@diia-inhouse/configs/dist/commitlint"
    },
    "release": {
        "extends": "@diia-inhouse/configs/dist/semantic-release/package"
    },
    "engines": {
        "node": ">=24"
    }
}
